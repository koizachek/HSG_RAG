chatbot.emba.unisg.ch {
    # --- PILOT PHASE (until 2026-08-31): IP allowlist (inactive draft) -------
    # Uncomment to activate. Blocks all requests except /health for clients
    # outside the allowlist. /health MUST stay public: deploy.yml verifies it
    # from GitHub runners, and blocking it would fail every deployment's
    # verification step.
    #
    # NOTE for the embed demo: the bot is iframed into a page on
    # emba.unisg.ch (see CSP frame-ancestors below). The iframe request comes
    # from the VISITOR's IP, not the web server's — so everyone who should see
    # the embedded demo (web team, advisors, DSB, supervisors) needs their
    # network in this list.
    #
    # TODO: insert the allowed addresses on the remote_ip line, space-separated.
    # Accepted formats (mix freely):
    #   single IPv4:  130.82.1.2
    #   IPv4 range:   130.82.0.0/16
    #   single IPv6:  2001:db8::1
    #   IPv6 range:   2001:db8::/32
    # Remember IPv6: pilot users on the university network may connect over it.
    #
    # @blocked {
    #     not remote_ip <IP-OR-CIDR> <IP-OR-CIDR>
    #     not path /health
    # }
    # respond @blocked "Zugriff während der Pilotphase (bis 31.08.2026) nur für registrierte Teilnehmende. / Access restricted to registered participants during the pilot phase (until 31 August 2026)." 403
    #
    # Removal after go-live: see .claude/skills/hsg-rag-run-and-operate
    # ("Pilot-phase IP allowlist"). Short version: delete this whole block
    # via PR, then scp to the host and `systemctl reload caddy`.
    # --- END PILOT PHASE ------------------------------------------------------

    reverse_proxy localhost:7860

    header -X-Frame-Options
    header Content-Security-Policy "frame-ancestors https://*.unisg.ch https://embax.ch https://*.embax.ch"
}
